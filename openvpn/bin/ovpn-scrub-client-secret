#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/pve-openvpn/common.sh

require_root
load_config
require_secure_root_dir "$EASYRSA_DIR"
require_secure_root_dir "$EASYRSA_PKI_DIR"
require_interactive_tty

(($# == 0)) || die "ovpn-scrub-client-secret не принимает аргументы. Запусти просто: ovpn-scrub-client-secret"

echo "=== Удаление серверных копий client secrets ==="
echo
if ! name="$(prompt_client_from_pki "V R E" "Выбери клиента:")"; then
  info "Отменено."
  exit 0
fi
validate_client_name "$name"

status="$(pki_client_status "$name" 2>/dev/null || true)"
[[ "$status" == "V" || "$status" == "R" || "$status" == "E" ]] ||
  die "Клиент '$name' не найден в PKI."

client_key="$EASYRSA_PKI_DIR/private/$name.key"
transport_key="$EASYRSA_PKI_DIR/tls-crypt-v2-clients/$name.key"
profile="$OVPN_CLIENT_DIR/$name.ovpn"
marker_dir="$EASYRSA_PKI_DIR/secret-scrubbed"
marker="$marker_dir/$name"

[[ ! -L "$marker_dir" && ! -L "$marker" ]] || die "Небезопасный scrub marker path."

echo
warn "Будут удалены серверные копии private key, transport key и экспортированный .ovpn клиента '$name'."
warn "Сертификат НЕ будет отозван: уже импортированный профиль продолжит работать."
warn "После scrub повторно экспортировать тот же профиль будет невозможно."
IFS= read -r -p "Для подтверждения введи ERASE: " confirm || die "Ввод прерван."
[[ "$confirm" == "ERASE" ]] || {
  info "Отменено."
  exit 0
}

# Не держим PKI lock во время пользовательского подтверждения.
acquire_pki_lock

status="$(pki_client_status "$name" 2>/dev/null || true)"
[[ "$status" == "V" || "$status" == "R" || "$status" == "E" ]] ||
  die "Состояние PKI изменилось: клиент '$name' больше не найден."

secrets=(
  "$client_key"
  "$transport_key"
  "$profile"
  "$EASYRSA_PKI_DIR/inline/$name.inline"
  "$EASYRSA_PKI_DIR/inline/private/$name.inline"
)

while IFS= read -r serial; do
  [[ "$serial" =~ ^[A-Fa-f0-9]+$ ]] || die "Некорректный serial в PKI index."
  secrets+=("$EASYRSA_PKI_DIR/revoked/private_by_serial/$serial.key")
done < <(awk -F '\t' -v target="$name" '
  { cn=$6; sub(/^.*CN=/, "", cn); sub(/\/.*/, "", cn); if (cn == target) print $4 }
' "$EASYRSA_PKI_DIR/index.txt")

for secret in "${secrets[@]}"; do
  [[ ! -L "$secret" ]] || die "Отказ: секретный path является symlink: $secret"
done

rm -f -- "${secrets[@]}"
install -d -o root -g root -m 0700 "$marker_dir"
printf 'client=%s\nscrubbed_at=%s\n' "$name" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$marker"
chmod 0600 "$marker"

info "Серверные копии client secrets удалены."
if [[ "$status" == "V" ]]; then
  echo "Клиент остаётся действующим. Для блокировки запусти ovpn-revoke-client и выбери его в меню."
fi
