#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/pve-openvpn/common.sh

require_root
require_cmd flock
require_cmd systemctl
if [[ -e /run/pve-openvpn || -L /run/pve-openvpn ]]; then
  [[ -d /run/pve-openvpn && ! -L /run/pve-openvpn ]] ||
    die "Небезопасный runtime directory: /run/pve-openvpn"
fi
install -d -o root -g root -m 0700 /run/pve-openvpn
exec 7>/run/pve-openvpn/config.lock
flock -x 7
load_config

mode="${1:-}"
[[ "$mode" == "split" || "$mode" == "full" ]] ||
  die "Использование: ovpn-set-mode split|full"

[[ "$mode" != "$OVPN_MODE" ]] || {
  info "Режим уже '$mode'."
  exit 0
}

backup="$(mktemp)"
candidate="$(mktemp)"
trap 'rm -f "$backup" "$candidate"' EXIT

cp --preserve=mode,ownership,timestamps "$CONFIG_FILE" "$backup"

awk -v mode="$mode" '
  BEGIN {done=0}
  /^OVPN_MODE=/ {
    print "OVPN_MODE=\"" mode "\""
    done=1
    next
  }
  {print}
  END {
    if (!done) print "OVPN_MODE=\"" mode "\""
  }
' "$CONFIG_FILE" > "$candidate"

rollback() {
  local failed=0
  warn "Откатываю изменение режима..."
  install -o root -g root -m 0600 "$backup" "$CONFIG_FILE" || failed=1
  /usr/local/sbin/ovpn-render-server >/dev/null 2>&1 || failed=1
  systemctl restart pve-openvpn-fw.service >/dev/null 2>&1 || failed=1
  systemctl restart "openvpn-server@${OVPN_SERVER_NAME}.service" >/dev/null 2>&1 || failed=1

  if (( failed )); then
    warn "Rollback применён не полностью; останавливаю OpenVPN fail-closed."
    systemctl stop "openvpn-server@${OVPN_SERVER_NAME}.service" >/dev/null 2>&1 || true
    return 1
  fi
}

install -o root -g root -m 0600 "$candidate" "$CONFIG_FILE"

if ! /usr/local/sbin/ovpn-render-server; then
  rollback || die "CRITICAL: rollback не завершён; OpenVPN остановлен."
  die "Не удалось сгенерировать server config для режима '$mode'. Старый режим восстановлен."
fi

if ! systemctl restart pve-openvpn-fw.service; then
  rollback || die "CRITICAL: rollback не завершён; OpenVPN остановлен."
  die "Не удалось применить firewall для режима '$mode'. Старый режим восстановлен."
fi

if ! systemctl restart "openvpn-server@${OVPN_SERVER_NAME}.service"; then
  rollback || die "CRITICAL: rollback не завершён; OpenVPN остановлен."
  die "OpenVPN не запустился с режимом '$mode'. Старый режим восстановлен."
fi

trap - EXIT
rm -f "$backup" "$candidate"

info "Режим изменён на '$mode'."
if [[ "$mode" == "full" ]]; then
  echo "Весь IPv4-трафик клиента будет направляться через VPN."
  warn "IPv6 этим набором не туннелируется. См. SECURITY.md/README про IPv6 bypass."
else
  echo "Через VPN отправляются только сети OVPN_LANS."
fi
