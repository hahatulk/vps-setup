#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/pve-openvpn/common.sh

require_root
load_config

index="$EASYRSA_PKI_DIR/index.txt"
[[ -r "$index" ]] || die "Не найден индекс PKI: $index"

printf '%-10s %-32s %-18s %-24s\n' "STATUS" "CLIENT" "EXPIRES" "SERIAL"
printf '%-10s %-32s %-18s %-24s\n' "----------" "--------------------------------" "------------------" "------------------------"

awk -F '\t' -v server_name="$OVPN_SERVER_NAME" '
function status_name(s) {
  if (s == "V") return "ACTIVE"
  if (s == "R") return "REVOKED"
  if (s == "E") return "EXPIRED"
  return s
}
{
  subject=$6
  client=subject
  sub(/^.*CN=/, "", client)
  sub(/\/.*/, "", client)
  if (client != server_name && client != "") {
    printf "%-10s %-32s %-18s %-24s\n", status_name($1), client, $2, $4
  }
}' "$index"
