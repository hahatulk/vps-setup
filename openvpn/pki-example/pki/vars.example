# Example only. The installer creates a runtime pki/vars when the PKI is new.
# Do not put passwords or private key material in this file.

set_var EASYRSA_DN "cn_only"
set_var EASYRSA_CA_EXPIRE 3650
set_var EASYRSA_CERT_EXPIRE 825

# Long CRL validity avoids an unexpected outage when CRL expires.
# Every client revoke operation still generates a fresh CRL immediately.
set_var EASYRSA_CRL_DAYS 3650

set_var EASYRSA_RAND_SN "yes"

# The kit builds its own .ovpn bundles and avoids extra Easy-RSA inline copies.
# Easy-RSA 3.2.x changed this variable name across releases; install.sh
# detects which names the installed easyrsa script supports.
# 3.2.2:
set_var EASYRSA_DISABLE_INLINE 1
# Newer 3.2.x:
set_var EASYRSA_NO_INLINE 1
