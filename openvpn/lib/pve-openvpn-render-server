#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck disable=SC1091
source /usr/local/lib/pve-openvpn/common.sh

require_root
require_cmd openssl
load_config

require_secure_root_dir "$SERVER_DIR"
for required_file in ca.crt server.crt server.key tls-crypt-v2-server.key; do
  [[ -f "$SERVER_DIR/$required_file" && ! -L "$SERVER_DIR/$required_file" && -s "$SERVER_DIR/$required_file" ]] ||
    die "Отсутствует безопасный regular file: $SERVER_DIR/$required_file"
done
crl_is_healthy "$SERVER_DIR/crl.pem" "$SERVER_DIR/ca.crt" ||
  die "CRL отсутствует, повреждён или истёк; server config не обновлён."
openssl verify -CAfile "$SERVER_DIR/ca.crt" "$SERVER_DIR/server.crt" >/dev/null 2>&1 ||
  die "Server certificate не проходит проверку CA."
openssl x509 -in "$SERVER_DIR/server.crt" -noout -checkend 0 >/dev/null 2>&1 ||
  die "Server certificate истёк."
cert_public_key="$(openssl x509 -in "$SERVER_DIR/server.crt" -pubkey -noout |
  openssl pkey -pubin -outform DER 2>/dev/null |
  openssl dgst -sha256 2>/dev/null)" || die "Не удалось прочитать public key server certificate."
key_public_key="$(openssl pkey -in "$SERVER_DIR/server.key" -pubout -outform DER 2>/dev/null |
  openssl dgst -sha256 2>/dev/null)" || die "Server private key повреждён или зашифрован."
[[ -n "$cert_public_key" && "$cert_public_key" == "$key_public_key" ]] ||
  die "Server certificate и private key не соответствуют друг другу."

read -r VPN_NETWORK VPN_NETMASK < <(cidr_network_netmask "$OVPN_VPN_CIDR")
SERVER_CONF="$SERVER_DIR/${OVPN_SERVER_NAME}.conf"
TLS_V2_SERVER_KEY="$SERVER_DIR/tls-crypt-v2-server.key"
SERVER_PROTO="$(openvpn_server_proto "$OVPN_PROTO")" ||
  die "Не удалось преобразовать OVPN_PROTO=$OVPN_PROTO в server proto."

chmod 0755 "$SERVER_DIR"
if [[ -e /var/log/openvpn || -L /var/log/openvpn ]]; then
  [[ -d /var/log/openvpn && ! -L /var/log/openvpn ]] ||
    die "Небезопасный log directory: /var/log/openvpn"
fi
install -d -o root -g nogroup -m 0750 /var/log/openvpn
if [[ -e /var/log/openvpn/status.log || -L /var/log/openvpn/status.log ]]; then
  [[ -f /var/log/openvpn/status.log && ! -L /var/log/openvpn/status.log ]] ||
    die "Status path не является безопасным regular file."
  chown nobody:nogroup /var/log/openvpn/status.log
  chmod 0600 /var/log/openvpn/status.log
else
  install -o nobody -g nogroup -m 0600 /dev/null /var/log/openvpn/status.log
fi

tmp="$(mktemp "$SERVER_DIR/.${OVPN_SERVER_NAME}.conf.XXXXXX")"
cleanup() { rm -f -- "$tmp"; }
trap cleanup EXIT

{
  cat <<EOF
# Generated by pve-openvpn-kit.
# Generated internally from $CONFIG_FILE; use the interactive ovpn tools instead.
port $OVPN_PORT
proto $SERVER_PROTO
dev $OVPN_TUN_IF
topology subnet
server $VPN_NETWORK $VPN_NETMASK
max-clients $OVPN_MAX_CLIENTS

ca $SERVER_DIR/ca.crt
cert $SERVER_DIR/server.crt
key $SERVER_DIR/server.key
dh none
EOF

  if [[ "$OVPN_PROTO" == "udp" ]]; then
    printf 'tls-crypt-v2 %s %s\n' "$TLS_V2_SERVER_KEY" "$OVPN_TLS_CRYPT_V2_COOKIE"
  else
    # force-cookie/allow-noncookie controls the UDP stateless-cookie handshake.
    # For TCP we still use per-client tls-crypt-v2 keys, but no UDP cookie mode.
    printf 'tls-crypt-v2 %s\n' "$TLS_V2_SERVER_KEY"
  fi

  cat <<EOF
crl-verify $SERVER_DIR/crl.pem
script-security 2
tls-verify /usr/local/lib/pve-openvpn/verify-crl-health

verify-client-cert require
remote-cert-tls client
tls-version-min 1.2
tls-cert-profile preferred
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
auth SHA256
allow-compression no

keepalive 10 120
persist-key
persist-tun
user nobody
group nogroup

status /var/log/openvpn/status.log
status-version 2
verb 3
EOF

  if [[ "$OVPN_PROTO" == "udp" || "$OVPN_PROTO" == udp* ]]; then
    echo "explicit-exit-notify 1"
  fi

  local_lan=""
  for local_lan in "${OVPN_LANS[@]}"; do
    read -r n m < <(cidr_network_netmask "$local_lan")
    printf 'push "route %s %s"\n' "$n" "$m"
  done

  if [[ "$OVPN_MODE" == "full" ]]; then
    echo 'push "redirect-gateway def1 bypass-dhcp"'
    for local_dns in "${OVPN_DNS[@]}"; do
      printf 'push "dhcp-option DNS %s"\n' "$local_dns"
    done
  fi
} > "$tmp"

chmod 0600 "$tmp"
mv -f -- "$tmp" "$SERVER_CONF"
trap - EXIT

info "Сформирован $SERVER_CONF"
