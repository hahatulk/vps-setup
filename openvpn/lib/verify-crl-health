#!/usr/bin/env bash
set -eu
umask 077
export LC_ALL=C

CRL="/etc/openvpn/server/crl.pem"
CA="/etc/openvpn/server/ca.crt"
OPENSSL="/usr/bin/openssl"
DATE="/usr/bin/date"
SED="/usr/bin/sed"

[[ -x "$OPENSSL" && -x "$DATE" && -x "$SED" ]] || exit 1
secure_file() {
  local file="$1" owner mode mode_dec
  [[ -f "$file" && ! -L "$file" && -s "$file" && -r "$file" ]] || return 1
  owner="$(/usr/bin/stat -c '%u' "$file" 2>/dev/null)" || return 1
  mode="$(/usr/bin/stat -c '%a' "$file" 2>/dev/null)" || return 1
  [[ "$owner" == 0 && "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  mode_dec=$((8#$mode))
  (( (mode_dec & 7022) == 0 ))
}
secure_file "$CRL" || exit 1
secure_file "$CA" || exit 1

"$OPENSSL" crl -in "$CRL" -noout -verify -CAfile "$CA" >/dev/null 2>&1 || exit 1

next_update="$(
  "$OPENSSL" crl -in "$CRL" -noout -nextupdate 2>/dev/null |
  "$SED" -n 's/^nextUpdate=//p'
)"
last_update="$(
  "$OPENSSL" crl -in "$CRL" -noout -lastupdate 2>/dev/null |
  "$SED" -n 's/^lastUpdate=//p'
)"
[[ -n "$next_update" && -n "$last_update" ]] || exit 1

next_epoch="$("$DATE" -u -d "$next_update" +%s 2>/dev/null)" || exit 1
last_epoch="$("$DATE" -u -d "$last_update" +%s 2>/dev/null)" || exit 1
now_epoch="$("$DATE" -u +%s)" || exit 1

(( next_epoch > now_epoch && last_epoch <= now_epoch + 300 )) || exit 1
exit 0
